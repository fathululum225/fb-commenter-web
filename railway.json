{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "DOCKERFILE"
    },
    "deploy": {
        "startCommand": "gunicorn --bind 0.0.0.0:$PORT --timeout 300 --workers 1 --threads 4 --worker-class gthread app:app",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 3
    }
}